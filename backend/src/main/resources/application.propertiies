# ===============================
# SERVER CONFIGURATION
# ===============================
server.port=8080

# ===============================
# SPRING DATASOURCE (MariaDB)
# ===============================
spring.datasource.url=jdbc:mariadb://localhost:3306/guardian
spring.datasource.username=root
spring.datasource.password=emmanuel
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
spring.datasource.initialization-mode=always

# ===============================
# JPA / HIBERNATE SETTINGS
# ===============================
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect

# ===============================
# FLYWAY DATABASE MIGRATION
# ===============================
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration

# ===============================
# JWT SETTINGS (example)
# ===============================
jwt.secret=YourJWTSecretKeyHere
jwt.expiration-ms=86400000  # 1 day in milliseconds

# ===============================
# CORS CONFIGURATION
# ===============================
# Allow frontend (React) to access backend
# This works globally if you use a WebMvcConfigurer
cors.allowed.origins=http://localhost:3000
cors.allowed.methods=GET,POST,PUT,DELETE,OPTIONS
cors.allowed.headers=*

# ===============================
# LOGGING
# ===============================
logging.level.org.springframework=INFO
logging.level.com.guardianai.ai=DEBUG
